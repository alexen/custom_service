#!/bin/sh

set -eux

reload_daemon_for_all_active_users() {
  active_users_=$(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}' | while read -r U; do
      if getent passwd "$U" | cut -d: -f7 | grep -qf /etc/shells; then
          echo "$U"
      fi
  done)
  for each_user in $active_users_; do
    if id "$each_user" >/dev/null 2>&1; then
      systemctl --machine="${each_user}@" --user daemon-reload >/dev/null 2>&1 || true
    fi
  done

  systemctl daemon-reload >/dev/null 2>&1 || true
}


reload_daemon_for_all_active_users
